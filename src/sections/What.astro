---
import type { ImageMetadata } from 'astro'
import { getCollection } from 'astro:content'

import Article from '@/components/Article.astro'
import Button from '@/components/Button.astro'
import { Carousel } from '@/components/Carousel/Carousel'
import { Gallery } from '@/components/Gallery'
import Img from '@/components/Img.astro'
import Section from '@/components/Section.astro'
import H3 from '@/components/Typography/H3.astro'
import forest from '@/images/forest.webp'
import { toGalleryImages } from '@/utils/toGalleryImages'

const seasons = await getCollection('seasons')

/*
 * Oldest first for the testimonials, newest first for the articles — the order
 * the section has always had.
 */
const oldestFirst = [...seasons].sort((a, b) => a.data.order - b.data.order)
const newestFirst = [...seasons].sort((a, b) => b.data.order - a.data.order)

const testimonials = oldestFirst.flatMap((season) => season.data.testimonials)
const seasonsWithArticles = newestFirst.filter(
  (season) => season.data.articles.length > 0,
)

/*
 * The home page shows the curated subset in `images/gallery/`, sorted by
 * filename; the season pages show each edition's full set. The order is
 * load-bearing — `Gallery` gives specific indices their own grid spans.
 */
const galleryModules = import.meta.glob<{ default: ImageMetadata }>(
  '../images/gallery/*.jpg',
  { eager: true },
)

const galleryImages = await toGalleryImages(
  Object.entries(galleryModules)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, module]) => module.default),
)

const photosUrl = newestFirst.find((season) => season.data.photosUrl)?.data.photosUrl
---

<Section
  id="jake-to-bylo"
  title="Jaké byly předchozí Pecky?"
  titleColor="text-brand-first"
  bg="bg-brand-second"
  class="relative min-h-[30rem]"
  full
>
  <div class="relative z-10">
    <p class="mx-auto mb-8 max-w-3xl text-center font-bold italic">
      První broskvová na přelomu roků 2023 a 2024 a druhá švestková v létě 2025. Podívejte
      se co o nich napsali účastníci.
    </p>
    <Carousel isCenterd items={testimonials} client:visible />
    <Gallery images={galleryImages} photosUrl={photosUrl} client:visible />
    {
      seasonsWithArticles.map((season, index) => (
        <div class="mx-auto grid max-w-screen-2xl grid-cols-1 gap-8 px-4 md:grid-cols-2 lg:grid-cols-3">
          <div class="col-span-full">
            <H3 class:list={['text-center', index > 0 && 'mt-16']}>
              {season.data.title} ročník {season.data.years}
            </H3>
          </div>
          {season.data.articles.map((article) => (
            <Article {...article} />
          ))}
        </div>
      ))
    }
    <div class="mt-16 flex justify-center">
      <Button to="/rocniky">Prohlédnout si všechny ročníky</Button>
    </div>
  </div>
  <div class="absolute right-0 -bottom-4 left-0 z-0 opacity-20">
    <Img src={forest} alt="" />
  </div>
</Section>
