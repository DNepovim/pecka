---
type Props = {
  title: string
  description?: string
  image?: string
  url?: string
  domain?: string
}

const { title, description, image, url, domain } = Astro.props
---

<title>{title}</title>
{description && <meta name="description" content={description} />}

{url && <meta property="og:url" content={url} />}
{description && <meta property="og:type" content="website" />}
{description && <meta property="og:title" content={title} />}
{description && <meta property="og:description" content={description} />}
{image && <meta property="og:image" content={image} />}

{image && <meta name="twitter:card" content="summary_large_image" />}
{domain && <meta property="twitter:domain" content={domain} />}
{url && <meta property="twitter:url" content={url} />}
{description && <meta name="twitter:title" content={title} />}
{description && <meta name="twitter:description" content={description} />}
{image && <meta name="twitter:image" content={image} />}
