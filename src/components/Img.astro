---
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'

import { rawDimensions, type ImageFit } from '@/utils/imageDimensions'

type Props = {
  src: ImageMetadata
  alt: string
  width?: number
  height?: number
  fit?: ImageFit
  position?: string
  widths?: number[]
  sizes?: string
  loading?: 'lazy' | 'eager'
  class?: string
}

const {
  src,
  alt,
  width,
  height,
  fit,
  position,
  widths,
  sizes,
  loading = 'lazy',
  class: className,
} = Astro.props

// Layout box sized the way `gatsby-plugin-image` sized it — see `rawDimensions`.
const raw = rawDimensions(src)
const ratio = raw.height / raw.width

const boxWidth = width ?? (height ? Math.round(height / ratio) : raw.width)
const boxHeight = height ?? Math.round(boxWidth * ratio)

const image = await getImage({
  src,
  width: boxWidth,
  height: boxHeight,
  fit,
  position,
  widths,
})
---

<img
  src={image.src}
  srcset={image.srcSet.attribute || undefined}
  sizes={sizes}
  width={boxWidth}
  height={boxHeight}
  alt={alt}
  loading={loading}
  decoding="async"
  class={className}
/>
